{
  "name": "woffice",
  "version": "0.1.0",
  "description": "Word 文档编辑服务库",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "build": "vite build && tsc && node scripts/fix-dts-alias.mjs",
    "lint": "oxlint",
    "test": "vitest",
    "e2e": "playwright test",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,html}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "word",
    "docx",
    "editor",
    "document"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
